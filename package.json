{
  "name": "gates-cdx-ritzel-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "description": "Build-Werkzeuge für den Online-Ritzel-Generator (web/).",
  "scripts": {
    "build": "npm run build:shell && npm run build:viewer && npm run docs",
    "test": "node tools/golden-test.mjs",
    "test:dicht": "node tools/dicht-test.mjs",
    "build:shell": "esbuild web/js/shell.js --bundle --format=iife --minify --outfile=web/js/shell.bundle.js",
    "build:viewer": "esbuild web/js/viewer.js --bundle --format=iife --minify --loader:.wasm=base64 --external:node:* --alias:three/addons=three/examples/jsm --outfile=web/js/viewer.bundle.js",
    "docs": "node tools/gen-readme.mjs"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "manifold-3d": "3.5.4",
    "three": "0.160.1"
  }
}
